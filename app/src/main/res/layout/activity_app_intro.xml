<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_contrast"
    tools:context=".appintro.AppIntroActivity">

    <com.zalexdev.stryker.utils.LightfallView
        android:id="@+id/intro_lightfall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:lf_backgroundGlow="0.0"
        app:lf_color1="@color/welcome_line_1"
        app:lf_color2="@color/welcome_line_2"
        app:lf_color3="@color/welcome_line_3"
        app:lf_density="0.6"
        app:lf_glow="1.0"
        app:lf_inkColor="@color/welcome_ink"
        app:lf_maxScale="0.8"
        app:lf_speed="0.5"
        app:lf_streakCount="2"
        app:lf_streakLength="1.0"
        app:lf_streakWidth="1.0"
        app:lf_targetFps="60"
        app:lf_traceSteps="32"
        app:lf_twinkle="1.0"
        app:lf_zoom="3.0" />

    <com.zalexdev.stryker.utils.FloatingLinesView
        android:id="@+id/intro_floating_lines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:fl_animationSpeed="1.0"
        app:fl_color1="@color/intro_line_1"
        app:fl_color2="@color/intro_line_2"
        app:fl_color3="@color/intro_line_3"
        app:fl_haze="0.0"
        app:fl_inkColor="@color/intro_ink"
        app:fl_lineCount="8"
        app:fl_lineDistance="8.0"
        app:fl_maxScale="0.85"
        app:fl_targetFps="60" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/intro_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="@dimen/intro_logo_size"
                    android:layout_height="@dimen/intro_logo_size"
                    android:src="@drawable/ic_blue"
                    app:tint="@color/stryker_logo_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/intro_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/intro_step"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/intro_step_placeholder"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/intro_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:indicatorColor="@color/stryker_accent"
                app:trackColor="@color/light_lite_contrast"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
